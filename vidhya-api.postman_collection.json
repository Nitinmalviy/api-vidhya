{
  "info": {
    "name": "Vidhya.care API",
    "description": "Complete API collection for Vidhya.care — Admin, Doctor, Patient. \n\nBase URL variable: {{base_url}} (default: http://localhost:5000)\n\nAuth tokens are auto-saved on login via Tests scripts:\n- Admin login  → saves {{admin_token}}\n- Doctor login → saves {{doctor_token}}\n- Patient login → saves {{patient_token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:5000", "type": "string" },
    { "key": "admin_token",   "value": "", "type": "string" },
    { "key": "doctor_token",  "value": "", "type": "string" },
    { "key": "patient_token", "value": "", "type": "string" },
    { "key": "doctor_id",     "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "🔑 Admin",
      "item": [

        {
          "name": "Auth",
          "item": [
            {
              "name": "Register Admin",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","admin","auth","register"] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Vidhya Admin\",\n  \"email\": \"admin@vidhyacare.in\",\n  \"password\": \"Admin@123\",\n  \"role\": \"SUPER_ADMIN\"\n}"
                }
              }
            },
            {
              "name": "Login Admin",
              "event": [{
                "listen": "test",
                "script": {
                  "exec": [
                    "var json = pm.response.json();",
                    "if (json.data && json.data.tokens) {",
                    "  pm.collectionVariables.set('admin_token', json.data.tokens.accessToken);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","admin","auth","login"] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"adminvidhya@yopmail.com\",\n  \"password\": \"admiVidhya@123\"\n}"
                }
              }
            },
            {
              "name": "Verify Email",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/auth/verify-email", "host": ["{{base_url}}"], "path": ["api","v1","admin","auth","verify-email"] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@vidhyacare.in\",\n  \"code\": \"<6-digit-code>\"\n}"
                }
              }
            },
            {
              "name": "Resend Verification",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/auth/resend-verification", "host": ["{{base_url}}"], "path": ["api","v1","admin","auth","resend-verification"] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@vidhyacare.in\"\n}"
                }
              }
            }
          ]
        },

        {
          "name": "Profile",
          "item": [
            {
              "name": "Get Admin Profile",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/profile", "host": ["{{base_url}}"], "path": ["api","v1","admin","profile"] }
              }
            },
            {
              "name": "Update Admin Profile",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "url": { "raw": "{{base_url}}/api/v1/admin/profile", "host": ["{{base_url}}"], "path": ["api","v1","admin","profile"] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Vidhya Super Admin\"\n}"
                }
              }
            }
          ]
        },

        {
          "name": "Dashboard",
          "item": [
            {
              "name": "Get Dashboard Stats",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/dashboard", "host": ["{{base_url}}"], "path": ["api","v1","admin","dashboard"] }
              }
            }
          ]
        },

        {
          "name": "Doctors",
          "item": [
            {
              "name": "Get All Doctors",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/doctors?status=PENDING&page=1&limit=20",
                  "host": ["{{base_url}}"],
                  "path": ["api","v1","admin","doctors"],
                  "query": [
                    { "key": "status", "value": "PENDING", "description": "PENDING | APPROVED | REJECTED (optional)" },
                    { "key": "page",   "value": "1" },
                    { "key": "limit",  "value": "20" }
                  ]
                }
              }
            },
            {
              "name": "Get Top Doctors (Approved)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/top-doctors", "host": ["{{base_url}}"], "path": ["api","v1","admin","top-doctors"] }
              }
            },
            {
              "name": "Verify Doctor (Approve / Reject)",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/verify-doctor/{{doctor_id}}",
                  "host": ["{{base_url}}"],
                  "path": ["api","v1","admin","verify-doctor","{{doctor_id}}"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"APPROVED\",\n  \"adminRemarks\": \"Documents verified successfully.\"\n}"
                }
              }
            }
          ]
        },

        {
          "name": "Patients",
          "item": [
            {
              "name": "Get All Patients",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/patients?page=1&limit=10",
                  "host": ["{{base_url}}"],
                  "path": ["api","v1","admin","patients"],
                  "query": [
                    { "key": "search", "value": "",       "description": "Search by name / email / phone", "disabled": true },
                    { "key": "plan",   "value": "FREE",   "description": "FREE | PREMIUM (optional)", "disabled": true },
                    { "key": "page",   "value": "1" },
                    { "key": "limit",  "value": "10" }
                  ]
                }
              }
            }
          ]
        },

        {
          "name": "Stats",
          "item": [
            {
              "name": "Growth Stats (Monthly / Yearly)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/stats/growth?timeFrame=monthly",
                  "host": ["{{base_url}}"],
                  "path": ["api","v1","admin","stats","growth"],
                  "query": [
                    { "key": "timeFrame", "value": "monthly", "description": "monthly | yearly" }
                  ]
                }
              }
            },
            {
              "name": "KYC Stats",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": { "raw": "{{base_url}}/api/v1/admin/stats/kyc", "host": ["{{base_url}}"], "path": ["api","v1","admin","stats","kyc"] }
              }
            }
          ]
        },

        {
          "name": "Health",
          "item": [
            {
              "name": "Admin Health Check",
              "request": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/api/v1/admin/health", "host": ["{{base_url}}"], "path": ["api","v1","admin","health"] }
              }
            }
          ]
        }
      ]
    },

